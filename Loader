local Theme = Library.Theme

local function Connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(Library.Connections, connection)
    return connection
end

local function New(class, properties, parent)
    local object = Instance.new(class)

    for key, value in pairs(properties or {}) do
        object[key] = value
    end

    object.Parent = parent
    return object
end

local function Corner(object, radius)
    return New("UICorner", {
        CornerRadius = UDim.new(0, radius or 6)
    }, object)
end

local function Stroke(object, color, thickness)
    return New("UIStroke", {
        Color = color or Theme.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, object)
end

local function Animate(object, properties, duration, style)
    local animation = TweenService:Create(
        object,
        TweenInfo.new(
            duration or 0.2,
            style or Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        properties
    )

    animation:Play()
    return animation
end

local function Label(parent, text, position, size, fontSize, color)
    return New("TextLabel", {
        Position = position,
        Size = size,
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextColor3 = color or Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = fontSize or 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    }, parent)
end

local function Button(parent, text, size, position)
    local button = New("TextButton", {
        Size = size,
        Position = position,
        BackgroundColor3 = Theme.Element,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        AutoButtonColor = false,
        BorderSizePixel = 0
    }, parent)

    Corner(button, 5)
    Stroke(button, Theme.Border)

    Connect(button.MouseEnter, function()
        Animate(button, {
            BackgroundColor3 = Theme.Hover
        })
    end)

    Connect(button.MouseLeave, function()
        Animate(button, {
            BackgroundColor3 = Theme.Element
        })
    end)

    return button
end

--==================================================
-- CONFIG SERIALIZER
--==================================================

local function Serialize(value, depth)
    depth = depth or 0

    if depth > 10 then
        return "nil"
    end

    local kind = typeof(value)

    if kind == "string" then
        return string.format("%q", value)
    elseif kind == "number" or kind == "boolean" then
        return tostring(value)
    elseif kind == "table" then
        local result = {"{"}

        for key, item in pairs(value) do
            if typeof(key) == "string" then
                table.insert(result,
                    "[" .. string.format("%q", key) .. "]=" ..
                    Serialize(item, depth + 1) .. ","
                )
            elseif typeof(key) == "number" then
                table.insert(result,
                    "[" .. key .. "]=" ..
                    Serialize(item, depth + 1) .. ","
                )
            end
        end

        table.insert(result, "}")
        return table.concat(result)
    end

    return "nil"
end

local function SaveFile(data)
    if not writefile then
        return false, "writefile indisponível"
    end

    local success, err = pcall(function()
        writefile(
            Library.ConfigFile,
            "-- Eclipse Yield Configuration\nreturn " ..
            Serialize(data)
        )
    end)

    return success, err
end

local function LoadFile()
    if not readfile or not isfile or not loadstring then
        return nil, "API de arquivos indisponível"
    end

    if not isfile(Library.ConfigFile) then
        return nil, "Arquivo não encontrado"
    end

    local success, result = pcall(function()
        local source = readfile(Library.ConfigFile)
        local chunk = loadstring(source)

        assert(chunk, "Configuração inválida")

        return chunk()
    end)

    if success and typeof(result) == "table" then
        return result
    end

    return nil, result
end

