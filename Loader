function Library:CreateWindow(options)
    options = options or {}

    local title = options.Title or "Eclipse Yield"
    local windowSize = options.Size or Vector2.new(680, 480)

    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)

    local width = math.min(windowSize.X, viewport.X - 20)
    local height = math.min(windowSize.Y, viewport.Y - 20)

    local Window = {
        Sections = {},
        Elements = {},
        ConfigData = {},
        Minimized = false,
        Destroyed = false,
        AutoSave = true,
        ToggleKey = options.ToggleKey or Enum.KeyCode.RightControl
    }

    local gui = New("ScreenGui", {
        Name = "EclipseYield",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, Player:WaitForChild("PlayerGui"))

    Window.Gui = gui

    local main = New("Frame", {
        Name = "Main",
        Size = UDim2.fromOffset(width, height),
        Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, gui)

    Window.Main = main

    Corner(main, 9)
    Stroke(main, Theme.Border, 1.2)

    -- TOPBAR

    local topbar = New("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 62),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0
    }, main)

    local moon = Label(
        topbar,
        "🌙",
        UDim2.fromOffset(14, 8),
        UDim2.fromOffset(43, 43),
        25
    )

    moon.TextXAlignment = Enum.TextXAlignment.Center

    Label(
        topbar,
        title,
        UDim2.fromOffset(65, 9),
        UDim2.new(1, -190, 0, 23),
        16
    )

    Label(
        topbar,
        "ECLIPSE YIELD  /  " .. Library.Version,
        UDim2.fromOffset(66, 32),
        UDim2.new(1, -190, 0, 17),
        9,
        Theme.SubText
    )

    local minimize = Button(
        topbar,
        "−",
        UDim2.fromOffset(27, 27),
        UDim2.new(1, -69, 0, 17)
    )

    local close = Button(
        topbar,
        "×",
        UDim2.fromOffset(27, 27),
        UDim2.new(1, -35, 0, 17)
    )

    -- DRAG

    do
        local dragging = false
        local startInput
        local startPosition

        Connect(topbar.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

                dragging = true
                startInput = input.Position
                startPosition = main.Position

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        Connect(UIS.InputChanged, function(input)
            if dragging and (
                input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch
            ) then

                local delta = input.Position - startInput

                main.Position = UDim2.new(
                    startPosition.X.Scale,
                    startPosition.X.Offset + delta.X,
                    startPosition.Y.Scale,
                    startPosition.Y.Offset + delta.Y
                )
            end
        end)
    end

    -- BODY

    local body = New("Frame", {
        Name = "Body",
        Size = UDim2.new(1, 0, 1, -62),
        Position = UDim2.fromOffset(0, 62),
        BackgroundTransparency = 1
    }, main)

    local sidebar = New("Frame", {
        Size = UDim2.new(0, 145, 1, -12),
        Position = UDim2.fromOffset(8, 5),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0
    }, body)

    Corner(sidebar, 7)

    local content = New("Frame", {
        Size = UDim2.new(1, -169, 1, -12),
        Position = UDim2.fromOffset(161, 5),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, body)

    Corner(content, 7)

    local sectionList = New("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new()
    }, sidebar)

    New("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, sectionList)

    New("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 10)
    }, sectionList)

    -- CONFIG API

    function Window:GetConfig()
        return self.ConfigData
    end

    function Window:SaveConfig()
        for _, element in ipairs(self.Elements) do
            if element.Get then
                self.ConfigData[element.ConfigKey] = element:Get()
            end
        end

        local success, err = SaveFile(self.ConfigData)

        if success then
            self:Notify({
                Title = "Configuration",
                Text = "config_meu.lua saved successfully."
            })
        else
            self:Notify({
                Title = "Configuration Error",
                Text = tostring(err)
            })
        end

        return success, err
    end

    function Window:LoadConfig()
        local data, err = LoadFile()

        if not data then
            self:Notify({
                Title = "Configuration",
                Text = tostring(err)
            })

            return false
        end

        self.ConfigData = data

        for _, element in ipairs(self.Elements) do
            local value = data[element.ConfigKey]

            if value ~= nil and element.Set then
                element:Set(value, true)
            end
        end

        self:Notify({
            Title = "Configuration",
            Text = "Configuration loaded."
        })

        return true
    end

    function Window:Notify(options)
        Library:Notify(options)
    end

    function Window:Toggle()
        if self.Destroyed then return end

        self.Visible = not self.Visible
        main.Visible = self.Visible
    end

    function Window:SetToggleKey(key)
        self.ToggleKey = key
    end

    function Window:Destroy()
        if self.Destroyed then return end

        self.Destroyed = true

        if self.AutoSave then
            self:SaveConfig()
        end

        gui:Destroy()
    end

    Window.Visible = true

    -- SETTINGS / CONFIG / SERVER

    local defaultSection = Window:AddSection("SYSTEM")

    local settings = defaultSection:AddTab("Settings")
    local config = defaultSection:AddTab("Config")
    local server = defaultSection:AddTab("Server")

    Window.Settings = settings
    Window.Config = config
    Window.Server = server

    -- SETTINGS

    settings:AddParagraph(
        "Interface Settings",
        "Customize your Eclipse Yield experience."
    )

    settings:AddToggle(
        "Notifications",
        true,
        function(value)
            Library.Notifications = value
        end,
        "Notifications"
    )

    settings:AddKeybind(
        "Menu Key",
        Window.ToggleKey,
        function(key)
            Window:SetToggleKey(key)
        end,
        "MenuKey"
    )

    settings:AddButton("Reset Position", function()
        Animate(main, {
            Position = UDim2.new(
                0.5, -width / 2,
                0.5, -height / 2
            )
        }, 0.3)
    end)

    settings:AddButton("Unload Library", function()
        Window:Destroy()
    end)

    -- CONFIG

    config:AddParagraph(
        "Configuration Manager",
        "Manage your settings using config_meu.lua."
    )

    config:AddLabel("FILE: config_meu.lua")

    config:AddButton("Save Configuration", function()
        Window:SaveConfig()
    end)

    config:AddButton("Load Configuration", function()
        Window:LoadConfig()
    end)

    config:AddToggle(
        "Auto Save",
        true,
        function(value)
            Window.AutoSave = value
        end,
        "AutoSave"
    )

    config:AddLabel("Auto Save Interval: 15 seconds")

    -- SERVER

    server:AddParagraph(
        "Server Information",
        "Current Roblox server information."
    )

    server:AddLabel("Username: " .. Player.Name)
    server:AddLabel("Display Name: " .. Player.DisplayName)
    server:AddLabel("User ID: " .. tostring(Player.UserId))
    server:AddLabel("Place ID: " .. tostring(game.PlaceId))
    server:AddLabel("Job ID: " .. tostring(game.JobId))

    server:AddButton("Copy Job ID", function()
        if setclipboard then
            local success = pcall(function()
                setclipboard(game.JobId)
            end)

            Window:Notify({
                Title = "Server",
                Text = success and "Job ID copied." or "Copy failed."
            })
        else
            Window:Notify({
                Title = "Server",
                Text = "Clipboard API unavailable."
            })
        end
    end)

    server:AddButton("Copy Place ID", function()
        if setclipboard then
            pcall(setclipboard, tostring(game.PlaceId))
        end
    end)

    -- MINIMIZE / CLOSE

    minimize.MouseButton1Click:Connect(function()
        Window.Minimized = not Window.Minimized

        body.Visible = not Window.Minimized

        Animate(main, {
            Size = UDim2.fromOffset(
                width,
                Window.Minimized and 62 or height
            )
        }, 0.25)
    end)

    close.MouseButton1Click:Connect(function()
        Window:Destroy()
    end)

    -- MOBILE BUTTON

    if UIS.TouchEnabled and not UIS.KeyboardEnabled then
        local mobile = Button(
            gui,
            "🌙",
            UDim2.fromOffset(48, 48),
            UDim2.new(0, 12, 0.5, -24)
        )

        mobile.TextSize = 23
        Corner(mobile, 24)
        Stroke(mobile, Theme.Accent, 1.5)

        mobile.MouseButton1Click:Connect(function()
            Window:Toggle()
        end)
    end

    -- KEYBIND

    Connect(UIS.InputBegan, function(input, processed)
        if not processed and not Window.Destroyed then
            if input.KeyCode == Window.ToggleKey then
                Window:Toggle()
            end
        end
    end)

    -- AUTO SAVE

    task.spawn(function()
        while not Window.Destroyed do
            task.wait(Library.AutoSaveInterval)

            if Window.Destroyed then break end

            if Window.AutoSave then
                for _, element in ipairs(Window.Elements) do
                    if element.Get then
                        Window.ConfigData[element.ConfigKey] = element:Get()
                    end
                end

                SaveFile(Window.ConfigData)
            end
        end
    end)

    table.insert(Library.Windows, Window)

    Library:Notify({
        Title = "Eclipse Yield",
        Text = "Interface initialized successfully.",
        Icon = "🌙"
    })

    if options.LoadConfig then
        Window:LoadConfig()
    end

    return Window
end

--==================================================
-- SECTION API
--==================================================

function Library:AddSectionAPI(Window, name)
    return Window:AddSection(name)
end

--==================================================
-- TAB API
--==================================================

function Library:CreateTab(Section, name)
    return Section:AddTab(name)
end

--==================================================
-- GLOBAL API
--==================================================

function Library:DestroyAll()
    for _, window in ipairs(self.Windows) do
        window:Destroy()
    end

    for _, connection in ipairs(self.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(self.Windows)
    table.clear(self.Connections)

    if NotificationGui then
        NotificationGui:Destroy()
    end
end

return Library
