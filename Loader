-- NOTIFICATIONS
--==================================================

local NotificationGui
local NotificationHolder
local NotificationCount = 0

local function GetNotifications()
    if NotificationHolder and NotificationHolder.Parent then
        return NotificationHolder
    end

    local parent = Player:WaitForChild("PlayerGui")

    NotificationGui = New("ScreenGui", {
        Name = "EclipseNotifications",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 10000
    }, parent)

    NotificationHolder = New("Frame", {
        Name = "NotificationHolder",
        Size = UDim2.fromOffset(310, 500),
        Position = UDim2.new(1, -325, 0, 18),
        BackgroundTransparency = 1
    }, NotificationGui)

    New("UIListLayout", {
        Padding = UDim.new(0, 9),
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        SortOrder = Enum.SortOrder.LayoutOrder
    }, NotificationHolder)

    return NotificationHolder
end

function Library:Notify(options)
    options = options or {}

    if not self.Notifications then
        return
    end

    local holder = GetNotifications()
    NotificationCount += 1

    local duration = math.max(1, options.Duration or 4)

    local card = New("Frame", {
        Name = "Notification",
        Size = UDim2.new(1, 0, 0, 76),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.04,
        BorderSizePixel = 0,
        LayoutOrder = NotificationCount
    }, holder)

    Corner(card, 8)
    Stroke(card, Theme.Border)

    local accent = New("Frame", {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.fromOffset(0, 8),
        BackgroundColor3 = options.Color or Theme.Accent,
        BorderSizePixel = 0
    }, card)

    Corner(accent, 4)

    local icon = Label(
        card,
        options.Icon or "🌙",
        UDim2.fromOffset(12, 9),
        UDim2.fromOffset(30, 30),
        19
    )

    icon.TextXAlignment = Enum.TextXAlignment.Center

    Label(
        card,
        options.Title or "Eclipse Yield",
        UDim2.fromOffset(49, 9),
        UDim2.new(1, -60, 0, 22),
        13
    )

    local description = Label(
        card,
        options.Text or "",
        UDim2.fromOffset(49, 32),
        UDim2.new(1, -60, 0, 29),
        11,
        Theme.SubText
    )

    description.TextWrapped = true
    description.TextYAlignment = Enum.TextYAlignment.Top

    local progressBackground = New("Frame", {
        Size = UDim2.new(1, -18, 0, 2),
        Position = UDim2.new(0, 9, 1, -6),
        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0
    }, card)

    local progress = New("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = options.Color or Theme.Accent,
        BorderSizePixel = 0
    }, progressBackground)

    local dismiss = Button(
        card,
        "×",
        UDim2.fromOffset(23, 23),
        UDim2.new(1, -29, 0, 5)
    )

    dismiss.TextSize = 17
    dismiss.BackgroundTransparency = 1

    local closed = false

    local function Close()
        if closed then return end
        closed = true

        Animate(card, {
            Position = UDim2.new(1, 60, 0, 0),
            BackgroundTransparency = 1
        }, 0.25)

        Animate(progressBackground, {
            BackgroundTransparency = 1
        }, 0.2)

        task.delay(0.28, function()
            if card.Parent then
                card:Destroy()
            end
        end)
    end

    dismiss.MouseButton1Click:Connect(Close)

    card.Position = UDim2.new(1, 60, 0, 0)
    card.BackgroundTransparency = 1

    Animate(card, {
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 0.04
    }, 0.35, Enum.EasingStyle.Back)

    Animate(progress, {
        Size = UDim2.new(0, 0, 1, 0)
    }, duration, Enum.EasingStyle.Linear)

    task.delay(duration, Close)
end

