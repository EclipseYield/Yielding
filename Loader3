local Theme = {
    Background = Color3.fromRGB(8, 8, 10),
    Sidebar = Color3.fromRGB(12, 12, 15),
    Element = Color3.fromRGB(19, 19, 23),
    ElementHover = Color3.fromRGB(29, 29, 34),
    Stroke = Color3.fromRGB(43, 43, 49),
    Red = Color3.fromRGB(190, 35, 45),
    RedLight = Color3.fromRGB(230, 55, 65),
    White = Color3.fromRGB(245, 245, 245),
    Gray = Color3.fromRGB(155, 155, 165),
    Off = Color3.fromRGB(55, 55, 62)
}

local Font = Enum.Font.Gotham

local function Create(class, properties, parent)
    local object = Instance.new(class)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function Corner(object, radius)
    Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 6)
    }, object)
end

local function Outline(object, color, thickness)
    return Create("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thickness or 1
    }, object)
end

local function Animate(object, properties, duration)
    local animation = TweenService:Create(
        object,
        TweenInfo.new(
            duration or 0.2,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        properties
    )

    animation:Play()
    return animation
end

local function GetParent()
    local success, result = pcall(function()
        if gethui then
            return gethui()
        end
    end)

    if success and result then
        return result
    end

    return Player:WaitForChild("PlayerGui")
end

local function MakeDraggable(object, target, connections)
    local dragging = false
    local dragStart
    local startPosition

    table.insert(connections, object.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = target.Position

            local ended
            ended = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    ended:Disconnect()
                end
            end)
        end
    end))

    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            target.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end))
end

