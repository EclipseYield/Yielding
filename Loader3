            -- TOGGLE

            function Tab:AddToggle(text, default, callback, id)
                local state = default == true
                local frame = NewRow(38)

                Create("TextLabel", {
                    Size = UDim2.new(1, -70, 1, 0),
                    Position = UDim2.fromOffset(11, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(text),
                    TextColor3 = Theme.White,
                    TextSize = 12,
                    Font = Font,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, frame)

                local track = Create("Frame", {
                    Size = UDim2.fromOffset(38, 20),
                    Position = UDim2.new(1, -50, 0.5, -10),
                    BackgroundColor3 = state and Theme.Red or Theme.Off,
                    BorderSizePixel = 0
                }, frame)

                Corner(track, 20)

                local knob = Create("Frame", {
                    Size = UDim2.fromOffset(14, 14),
                    Position = state
                        and UDim2.fromOffset(21, 3)
                        or UDim2.fromOffset(3, 3),
                    BackgroundColor3 = Theme.White,
                    BorderSizePixel = 0
                }, track)

                Corner(knob, 20)

                local hitbox = Create("TextButton", {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Text = ""
                }, frame)

                local Toggle = {}

                function Toggle:Set(value, silent)
                    state = value == true

                    Animate(track, {
                        BackgroundColor3 = state and Theme.Red or Theme.Off
                    }, 0.15)

                    Animate(knob, {
                        Position = state
                            and UDim2.fromOffset(21, 3)
                            or UDim2.fromOffset(3, 3)
                    }, 0.15)

                    Window.Values[self.ConfigId] = state

                    if callback and not silent then
                        task.spawn(callback, state)
                    end
                end

                function Toggle:Get()
                    return state
                end

                Register(id, Toggle, state)

                Connect(hitbox.MouseButton1Click, function()
                    Toggle:Set(not state)
                end)

                return Toggle
            end

            -- SLIDER

            function Tab:AddSlider(text, minimum, maximum, default, callback, id)
                minimum = minimum or 0
                maximum = maximum or 100

                if maximum < minimum then
                    maximum = minimum
                end

                local value = math.clamp(
                    default or minimum,
                    minimum,
                    maximum
                )

                local frame = NewRow(55)

                local label = Create("TextLabel", {
                    Size = UDim2.new(1, -20, 0, 22),
                    Position = UDim2.fromOffset(10, 3),
                    BackgroundTransparency = 1,
                    TextColor3 = Theme.White,
                    TextSize = 12,
                    Font = Font,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, frame)

                local bar = Create("Frame", {
                    Size = UDim2.new(1, -20, 0, 6),
                    Position = UDim2.new(0, 10, 1, -14),
                    BackgroundColor3 = Theme.Off,
                    BorderSizePixel = 0
                }, frame)

                Corner(bar, 5)

                local fill = Create("Frame", {
                    Size = UDim2.new(
                        maximum == minimum and 0 or
                            (value - minimum) / (maximum - minimum),
                        0, 1, 0
                    ),
                    BackgroundColor3 = Theme.Red,
                    BorderSizePixel = 0
                }, bar)

                Corner(fill, 5)

                local Slider = {}

                local function Refresh()
                    label.Text = tostring(text) .. ": " .. tostring(value)
                end

                function Slider:Set(newValue, silent)
                    value = math.clamp(
                        math.floor(newValue + 0.5),
                        minimum,
                        maximum
                    )

                    local alpha = maximum == minimum and 0
                        or (value - minimum) / (maximum - minimum)

                    Animate(fill, {
                        Size = UDim2.new(alpha, 0, 1, 0)
                    }, 0.1)

                    Refresh()
                    Window.Values[self.ConfigId] = value

                    if callback and not silent then
                        task.spawn(callback, value)
                    end
                end

                function Slider:Get()
                    return value
                end

                Register(id, Slider, value)
                Refresh()

                local dragging = false

                local function Update(input)
                    if bar.AbsoluteSize.X <= 0 then
                        return
                    end

                    local alpha = math.clamp(
                        (input.Position.X - bar.AbsolutePosition.X)
                            / bar.AbsoluteSize.X,
                        0, 1
                    )

                    Slider:Set(minimum + (maximum - minimum) * alpha)
                end

                Connect(bar.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then

                        dragging = true
                        Update(input)
                    end
                end)

                Connect(UserInputService.InputChanged, function(input)
                    if dragging and (
                        input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch
                    ) then
                        Update(input)
                    end
                end)

                Connect(UserInputService.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then

                        dragging = false
                    end
                end)

                return Slider
            end

            -- TEXTBOX

            function Tab:AddTextBox(text, placeholder, callback, id)
                local frame = NewRow(40)

                Create("TextLabel", {
                    Size = UDim2.new(0.4, 0, 1, 0),
                    Position = UDim2.fromOffset(10, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(text),
                    TextColor3 = Theme.White,
                    TextSize = 12,
                    Font = Font,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, frame)

                local box = Create("TextBox", {
                    Size = UDim2.new(0.55, -10, 0, 26),
                    Position = UDim2.new(0.45, 0, 0.5, -13),
                    BackgroundColor3 = Theme.Background,
                    Text = "",
                    PlaceholderText = placeholder or "Type here...",
                    PlaceholderColor3 = Theme.Gray,
                    TextColor3 = Theme.White,
                    TextSize = 11,
                    Font = Font,
                    ClearTextOnFocus = false
                }, frame)

                Corner(box, 4)
                Outline(box, Theme.Stroke)

                local TextBox = {}

                function TextBox:Set(value, silent)
                    box.Text = tostring(value or "")
                    Window.Values[self.ConfigId] = box.Text

                    if callback and not silent then
                        task.spawn(callback, box.Text)
                    end
                end

                function TextBox:Get()
                    return box.Text
                end

                Register(id, TextBox, "")

                Connect(box.FocusLost, function()
                    Window.Values[id or TextBox.ConfigId] = box.Text

                    if callback then
                        task.spawn(callback, box.Text)
                    end
                end)

                return TextBox
            end

            -- DROPDOWN

            function Tab:AddDropdown(text, optionsList, default, callback, id)
                optionsList = optionsList or {}

                local selected = default or optionsList[1] or "None"
                local frame = NewRow(40)

                Create("TextLabel", {
                    Size = UDim2.new(0.45, 0, 1, 0),
                    Position = UDim2.fromOffset(10, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(text),
                    TextColor3 = Theme.White,
                    TextSize = 12,
                    Font = Font,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, frame)

                local button = Create("TextButton", {
                    Size = UDim2.new(0.5, -10, 0, 27),
                    Position = UDim2.new(0.5, 0, 0.5, -13),
                    BackgroundColor3 = Theme.Background,
                    Text = tostring(selected) .. "  ▼",
                    TextColor3 = Theme.White,
                    TextSize = 11,
                    Font = Font,
                    AutoButtonColor = false
                }, frame)

                Corner(button, 4)
                Outline(button, Theme.Stroke)

                local index = 1

                local Dropdown = {}

                function Dropdown:Set(value, silent)
                    selected = value
                    button.Text = tostring(selected) .. "  ▼"

                    for i, option in ipairs(optionsList) do
                        if option == value then
                            index = i
                            break
                        end
                    end

                    Window.Values[self.ConfigId] = selected

                    if callback and not silent then
                        task.spawn(callback, selected)
                    end
                end

                function Dropdown:Get()
                    return selected
                end

                Register(id, Dropdown, selected)

                Connect(button.MouseButton1Click, function()
                    if #optionsList == 0 then
                        return
                    end

                    index += 1

                    if index > #optionsList then
                        index = 1
                    end

                    Dropdown:Set(optionsList[index])
                end)

                return Dropdown
            end

            -- KEYBIND

            function Tab:AddKeybind(text, default, callback, id)
                local key = default or Enum.KeyCode.RightControl
                local waiting = false

                local frame = NewRow(38)

                Create("TextLabel", {
                    Size = UDim2.new(0.6, 0, 1, 0),
                    Position = UDim2.fromOffset(10, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(text),
                    TextColor3 = Theme.White,
                    TextSize = 12,
                    Font = Font,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, frame)

                local button = Create("TextButton", {
                    Size = UDim2.fromOffset(100, 25),
                    Position = UDim2.new(1, -110, 0.5, -12),
                    BackgroundColor3 = Theme.Background,
                    Text = key.Name,
                    TextColor3 = Theme.White,
                    TextSize = 11,
                    Font = Font,
                    AutoButtonColor = false
                }, frame)

                Corner(button, 4)
                Outline(button, Theme.Stroke)

                local Keybind = {}

                function Keybind:Set(newKey, silent)
                    key = newKey
                    button.Text = key.Name
                    Window.Values[self.ConfigId] = key.Name

                    if callback and not silent then
                        task.spawn(callback, key)
                    end
                end

                function Keybind:Get()
                    return key
                end

                Register(id, Keybind, key.Name)

                Connect(button.MouseButton1Click, function()
                    waiting = true
                    button.Text = "Press key..."
                end)

                Connect(UserInputService.InputBegan, function(input, processed)
                    if processed then
                        return
                    end

                    if waiting and input.KeyCode ~= Enum.KeyCode.Unknown then
                        waiting = false
                        Keybind:Set(input.KeyCode)
                        return
                    end

                    if not waiting and input.KeyCode == key and callback then
                        task.spawn(callback, key)
                    end
                end)

                return Keybind
            end

            table.insert(Section.Tabs, Tab)

            if not Window.CurrentTab then
                Tab:Select()
            end

            return Tab
        end

        table.insert(Window.Sections, Section)

        return Section
    end

    --==================================================
    -- BUILT-IN TABS
    --==================================================

    local system = Window:AddSection("SYSTEM")

    Window.Settings = system:AddTab("Settings")
    Window.Config = system:AddTab("Config")
    Window.Server = system:AddTab("Server")

    -- SETTINGS

    Window.Settings:AddLabel("Interface settings")

    Window.Settings:AddToggle(
        "Notifications",
        true,
        function(value)
            Library.Notifications = value
        end,
        "setting_notifications"
    )

    Window.Settings:AddToggle(
        "Auto Save",
        true,
        function(value)
            Window:SetAutoSave(value)
        end,
        "setting_autosave"
    )

    Window.Settings:AddKeybind(
        "Toggle Menu",
        Window.ToggleKey,
        function(key)
            Window:SetToggleKey(key)
        end,
        "setting_togglekey"
    )

    Window.Settings:AddButton("Unload Interface", function()
        Window:Destroy()
    end)

    -- CONFIG

    Window.Config:AddLabel("Configuration manager")

    Window.Config:AddParagraph(
        "Config file",
        Library.ConfigFile
    )

    Window.Config:AddButton("Save Configuration", function()
        Window:SaveConfig()
    end)

    Window.Config:AddButton("Load Configuration", function()
        Window:LoadConfig()
    end)

    Window.Config:AddButton("Reset Configuration", function()
        for id, element in pairs(Window.Elements) do
            local default = element.Default

            if default ~= nil and element.Set then
                element:Set(default, true)
            end
        end

        Library:Notify({
            Title = "Configuration",
            Text = "Reset completed.",
            Duration = 2
        })
    end)

    -- SERVER

    Window.Server:AddLabel("Current server information")

    Window.Server:AddParagraph(
        "Player",
        Player.Name
    )

    Window.Server:AddParagraph(
        "User ID",
        tostring(Player.UserId)
    )

    Window.Server:AddParagraph(
        "Place ID",
        tostring(game.PlaceId)
    )

    Window.Server:AddParagraph(
        "Job ID",
        game.JobId ~= "" and game.JobId or "Unavailable"
    )

    Window.Server:AddButton("Copy Job ID", function()
        if setclipboard then
            setclipboard(game.JobId)
            Library:Notify({
                Title = "Server",
                Text = "Job ID copied.",
                Duration = 2
            })
        else
            Library:Notify({
                Title = "Server",
                Text = "Clipboard is not supported.",
                Duration = 2
            })
        end
    end)

    Window.Server:AddButton("Copy Place ID", function()
        if setclipboard then
            setclipboard(tostring(game.PlaceId))
            Library:Notify({
                Title = "Server",
                Text = "Place ID copied.",
                Duration = 2
            })
        end
    end)

    -- LOAD SAVED CONFIG AFTER ELEMENTS EXIST

    local saved = LoadTableFromFile(Library.ConfigFile)

    if saved then
        for id, value in pairs(saved) do
            local element = Window.Elements[id]

            if element and element.Set then
                pcall(function()
                    if id == "setting_togglekey" and typeof(value) == "string" then
                        element:Set(Enum.KeyCode[value], true)
                    else
                        element:Set(value, true)
                    end
                end)
            end
        end
    end

    Library:Notify({
        Title = options.Title or "Eclipse Yield",
        Text = "Interface successfully loaded.",
        Duration = 3
    })

    return Window
end

return Library
