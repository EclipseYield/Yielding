    -- WINDOW METHODS

    function Window:Notify(data)
        Library:Notify(data)
    end

    function Window:Show()
        if not Window.Destroyed then
            main.Visible = true
        end
    end

    function Window:Hide()
        if not Window.Destroyed then
            main.Visible = false
        end
    end

    function Window:Toggle()
        if not Window.Destroyed then
            main.Visible = not main.Visible
        end
    end

    function Window:SetToggleKey(key)
        Window.ToggleKey = key
    end

    function Window:Destroy()
        if Window.Destroyed then
            return
        end

        Window.Destroyed = true

        if Window.AutoSaveEnabled then
            self:SaveConfig()
        end

        for _, connection in ipairs(Window.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        table.clear(Window.Connections)

        if gui then
            gui:Destroy()
        end
    end

    Connect(close.MouseButton1Click, function()
        Window:Destroy()
    end)

    Connect(minimize.MouseButton1Click, function()
        Window.Minimized = not Window.Minimized
        body.Visible = not Window.Minimized

        Animate(main, {
            Size = UDim2.fromOffset(
                width,
                Window.Minimized and 58 or height
            )
        }, 0.2)
    end)

    Connect(UserInputService.InputBegan, function(input, processed)
        if processed or Window.Destroyed then
            return
        end

        if input.KeyCode == Window.ToggleKey then
            Window:Toggle()
        end
    end)

    --==================================================
    -- CONFIG API
    --==================================================

    function Window:SaveConfig()
        local success = SaveTableToFile(
            Library.ConfigFile,
            Window.Values
        )

        if success then
            Library:Notify({
                Title = "Configuration",
                Text = "Config saved to " .. Library.ConfigFile,
                Duration = 2
            })
        else
            Library:Notify({
                Title = "Configuration",
                Text = "Could not save. Check executor file support.",
                Duration = 3
            })
        end

        return success
    end

    function Window:LoadConfig()
        local data = LoadTableFromFile(Library.ConfigFile)

        if not data then
            Library:Notify({
                Title = "Configuration",
                Text = "No valid config file was found.",
                Duration = 3
            })
            return false
        end

        for key, value in pairs(data) do
            local element = Window.Elements[key]

            if element and element.Set then
                pcall(function()
                    element:Set(value, true)
                end)
            end
        end

        Library:Notify({
            Title = "Configuration",
            Text = "Configuration loaded.",
            Duration = 2
        })

        return true
    end

    function Window:SetAutoSave(enabled)
        Window.AutoSaveEnabled = enabled

        Library.AutoSave = enabled
    end

    Window.AutoSaveEnabled = Library.AutoSave

    task.spawn(function()
        while not Window.Destroyed do
            task.wait(15)

            if Window.Destroyed then
                break
            end

            if Window.AutoSaveEnabled then
                SaveTableToFile(Library.ConfigFile, Window.Values)
            end
        end
    end)

